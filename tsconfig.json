{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["esnext"],
    "types": ["node"],
    "module": "esnext",
    "moduleResolution": "bundler",

    "strict": true,
    "allowJs": true,

    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["code", "algorithm"],
  "ts-node": {
    "transpileOnly": true
  }
}
